<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="34dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <!-- The line badge: a rounded shape tinted with the line color, its number on top. -->
    <FrameLayout
        android:layout_width="38dp"
        android:layout_height="24dp">
        <ImageView
            android:id="@+id/row_badge"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_badge" />
        <TextView
            android:id="@+id/row_line"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="12sp"
            android:textStyle="bold" />
    </FrameLayout>
    <TextView
        android:id="@+id/row_terminus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_fg"
        android:textSize="13sp" />
    <ImageView
        android:id="@+id/row_live"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginEnd="4dp"
        android:contentDescription="temps réel"
        android:src="@drawable/ic_live"
        android:tint="@color/widget_accent" />
    <TextView
        android:id="@+id/row_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_fg"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
